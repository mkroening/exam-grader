<!-- Created with Cambalache 0.12.1 -->
<interface>
  <!-- interface-name About.ui -->
  <requires lib="gtk" version="4.0"/>
  <object class="GtkAboutDialog" id="about">
    <property name="authors">Jonathan Klimt</property>
    <property name="copyright" translatable="yes">Jonathan Klimt</property>
    <property name="license-type">gpl-3-0</property>
    <property name="logo-icon-name">/exam-grader/assets/exam.svg</property>
    <property name="modal">1</property>
    <property name="program-name">Exam Grader</property>
    <property name="version">0.1.0</property>
    <property name="website">https://git.rwth-aachen.de/acs/public/exam-tools/exam-grader</property>
  </object>
</interface>
