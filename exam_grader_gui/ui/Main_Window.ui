<interface>
  <!-- interface-name Main_Window.ui -->
  <requires lib="gtk" version="4.10"/>
  <template class="main_window" parent="GtkApplicationWindow">
    <property name="child">
      <object class="GtkOverlay">
        <property name="child">
          <object class="GtkStack" id="main_stack">
            <signal name="notify::visible-child-name" handler="main_visible_child_changed"/>
            <child>
              <object class="GtkStackPage" id="exam_page">
                <property name="child">
                  <object class="GtkGrid" id="exam_page_grid">
                    <property name="column-spacing">15</property>
                    <property name="halign">center</property>
                    <property name="margin-bottom">5</property>
                    <property name="margin-end">5</property>
                    <property name="margin-start">5</property>
                    <property name="margin-top">5</property>
                    <property name="row-spacing">10</property>
                    <child>
                      <object class="GtkLabel" id="GeneralHeading">
                        <property name="label">General:</property>
                        <style>
                          <class name="title-3"/>
                        </style>
                        <layout>
                          <property name="column">0</property>
                          <property name="column-span">2</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="ExamnameLabel">
                        <property name="halign">start</property>
                        <property name="label">Examname</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="DateLabel">
                        <property name="halign">start</property>
                        <property name="label">Date</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">2</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScrolledWindow">
                        <property name="child">
                          <object class="GtkViewport">
                            <property name="child">
                              <object class="GtkListBox" id="task_list">
                                <property name="hexpand">True</property>
                                <property name="selection-mode">none</property>
                                <child>
                                  <object class="GtkListBoxRow">
                                    <child>
                                      <object class="GtkBox">
                                        <property name="halign">center</property>
                                        <child>
                                          <object class="GtkLabel">
                                            <property name="halign">start</property>
                                            <property name="label">Task Name</property>
                                            <property name="width-request">220</property>
                                            <property name="xalign">0.0</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkLabel">
                                            <property name="label">Max Points</property>
                                            <property name="width-request">80</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkLabel">
                                            <property name="width-request">50</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkSeparator"/>
                                </child>
                              </object>
                            </property>
                          </object>
                        </property>
                        <property name="has-frame">True</property>
                        <property name="min-content-height">300</property>
                        <property name="vexpand">True</property>
                        <property name="vexpand-set">True</property>
                        <property name="width-request">500</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="column-span">2</property>
                          <property name="row">4</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="TasksHeading">
                        <property name="label">Tasks:</property>
                        <style>
                          <class name="title-3"/>
                        </style>
                        <layout>
                          <property name="column">0</property>
                          <property name="column-span">2</property>
                          <property name="row">3</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="examname_entry">
                        <property name="hexpand">True</property>
                        <property name="placeholder-text">MyExam</property>
                        <signal name="changed" handler="on_examname_changed"/>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuButton" id="examdate_button">
                        <property name="halign">end</property>
                        <property name="label">&lt;select&gt;</property>
                        <property name="popover">
                          <object class="GtkPopover">
                            <child>
                              <object class="GtkCalendar">
                                <signal name="day-selected" handler="on_examdate_clicked"/>
                              </object>
                            </child>
                          </object>
                        </property>
                        <property name="width-request">200</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">2</property>
                        </layout>
                      </object>
                    </child>
                  </object>
                </property>
                <property name="name">exam_page</property>
                <property name="title">Exam</property>
