              <object class="GtkButton" id="open_button">
                <property name="icon-name">document-open-symbolic</property>
                <property name="tooltip-markup" translatable="yes">Open Examgrading file  &lt;span style="italic"&gt;- CTRL + O&lt;/span&gt;</property>
                <signal name="clicked" handler="open"/>
                <style/>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="save_button">
                <property name="icon-name">document-save-symbolic</property>
                <property name="tooltip-markup" translatable="yes">Save exam grading  &lt;span style="italic"&gt;- CTRL + S&lt;/span&gt;</property>
                <signal name="clicked" handler="on_save_clicked"/>
                <style/>
              </object>
            </child>
            <style>
              <class name="linked"/>
            </style>
          </object>
        </child>
        <child type="title">
          <object class="GtkStackSwitcher" id="main_stack_switcher">
            <property name="stack">main_stack</property>
            <property name="width-request">100</property>
          </object>
        </child>
      </object>
    </property>
    <property name="width-request">1075</property>
    <signal name="close-request" handler="quit_with_confirmation"/>
  </template>
  <object class="GtkAdjustment" id="grade_stepsize_adjustment">
    <property name="page-increment">10</property>
    <property name="step-increment">0.5</property>
    <property name="upper">100</property>
    <property name="value">1</property>
  </object>
  <object class="GtkPopover" id="help_menu_popover">
    <property name="child">
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkCheckButton" id="grade_separators_checkbox">
            <property name="active">1</property>
            <property name="focusable">1</property>
            <property name="label" translatable="yes">Grade separators</property>
            <property name="tooltip-text" translatable="yes">Show separator lines in the point histogram</property>
            <signal name="toggled" handler="on_grade_sep_toggle"/>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="patch_csv_button">
            <property name="focusable">1</property>
            <property name="label" translatable="yes">Patch CSV</property>
            <property name="receives-default">1</property>
            <property name="tooltip-text" translatable="yes">Patch an existing CSV with the results of the exam.</property>
            <signal name="clicked" handler="on_csv_patch_clicked"/>
            <style>
              <class name="flat"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="about_button">
            <property name="focusable">1</property>
            <property name="label" translatable="yes">About</property>
            <property name="receives-default">1</property>
            <signal name="clicked" handler="on_about_clicked"/>
            <style>
              <class name="flat"/>
            </style>
          </object>
        </child>
      </object>
    </property>
    <property name="width-request">150</property>
  </object>
  <object class="GtkAdjustment" id="passing_adjustment">
    <property name="page-increment">10</property>
    <property name="step-increment">0.5</property>
    <property name="upper">10000</property>
    <property name="value">10</property>
  </object>
</interface>
